% tnviz.sty -- tensor-network figures in tnv, computed by the tnviz engine.
%
% The LaTeX interface of docs/architecture.md, section 4.1; the files and
% runs are specified in docs/protocol.md.
%
%   \begin{tnvfigure}[name=mps, unit=1cm]
%     chain A[1..6]
%     A[*]: leg down
%   \end{tnvfigure}
%
%   \tnvinput[unit=8mm]{figures/peps.tnv}
%
% LaTeX writes each figure's tnv source and \jobname.tnvm; `tnviz tex
% \jobname` writes the figures' .tikz files; the next LaTeX run draws them
% with tnviz-runtime.sty and records the typeset size of every label.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{tnviz}[2026/09/22 v0.1 tnv figures]
\RequirePackage{tnviz-runtime}
\RequirePackage{fancyvrb}

% ---- Options ---------------------------------------------------------------

\pgfkeys{
  /tnv/.is family, /tnv,
  name/.store in=\tnv@name,
  unit/.store in=\tnv@unitlength,
  unit=1cm,
}
\newcommand{\tnvset}[1]{\pgfkeys{/tnv,#1}}

% ---- .tnvm -----------------------------------------------------------------

\newwrite\tnv@tnvm
\newif\iftnv@tnvmopen
\newif\iftnv@missing
\newcount\tnv@unnamed

\def\tnv@write#1{%
  \iftnv@tnvmopen\else
    \immediate\openout\tnv@tnvm=\jobname.tnvm\relax
    \immediate\write\tnv@tnvm{tnvm 1}%
    \global\tnv@tnvmopentrue
  \fi
  \immediate\write\tnv@tnvm{#1}%
}

% Every figure name once per run.
\def\tnv@claim#1{%
  \ifcsname tnv@figure@#1\endcsname
    \PackageError{tnviz}{Two figures are named `#1'}%
      {Give each tnvfigure and \string\tnvinput\space its own name.}%
  \fi
  \global\expandafter\let\csname tnv@figure@#1\endcsname\relax
}

% Settle a figure's options and name, and record it in .tnvm with its
% source file, #2.
\def\tnv@begin#1#2{%
  \let\tnv@name\@empty
  \pgfkeys{/tnv,#1}%
  \ifx\tnv@name\@empty
    \global\advance\tnv@unnamed by 1
    \edef\tnv@name{fig\the\tnv@unnamed}%
  \fi
  \tnv@claim\tnv@name
  \edef\tnv@source{#2}%
  \dimen@=\tnv@unitlength\relax
  \edef\tnv@unitpt{\strip@pt\dimen@}%
  \edef\tnv@empt{\strip@pt\fontdimen6\font}%
  \tnv@write{figure \tnv@name\space unit=\tnv@unitpt\space
    em=\tnv@empt\space source=\tnv@source}%
}

% ---- Drawing ---------------------------------------------------------------

% The runtime reports every label's typeset size here.
\def\tnv@measured#1#2#3#4{\tnv@write{label \tnv@name\space #1 #2 #3 #4}}

\def\tnv@draw{%
  \edef\tnv@tikz{\jobname-\tnv@name.tikz}%
  \IfFileExists{\tnv@tikz}{%
    \begingroup
      \let\tnvMeasured\tnv@measured
      \begin{tikzpicture}[x=\tnv@unitlength, y=\tnv@unitlength]
        \input{\tnv@tikz}%
      \end{tikzpicture}%
    \endgroup
  }{%
    \global\tnv@missingtrue
    \PackageWarning{tnviz}{Figure `\tnv@name' is not computed yet}%
    \fbox{\parbox[c][2cm][c]{5cm}{\centering\ttfamily
      tnv figure \tnv@name\\ run tnviz tex \jobname}}%
  }%
}

\AtEndDocument{%
  \iftnv@missing
    \PackageWarningNoLine{tnviz}{Some figures are not computed yet; run
      `tnviz tex \jobname' and LaTeX again}%
  \fi
}

% ---- Figures ---------------------------------------------------------------

% The body is copied verbatim to \jobname-<name>.tnv.  The optional
% argument must be on the \begin line: the end of that line is made active
% before looking for `[', so that an environment without options does not
% read its first line too early.
\newenvironment{tnvfigure}{%
  \catcode`\^^M=\active
  \futurelet\tnv@next\tnv@figureoptions
}{%
  \end{VerbatimOut}%
  \tnv@draw
}
\def\tnv@figureoptions{%
  \ifx\tnv@next[%
    \expandafter\tnv@figurewith
  \else
    \expandafter\tnv@figurewithout
  \fi
}
\def\tnv@figurewith[#1]{\tnv@figure{#1}}
\def\tnv@figurewithout{\tnv@figure{}}
\def\tnv@figure#1{%
  \catcode`\^^M=5
  % \tnv@begin expands the source name after settling \tnv@name.
  \tnv@begin{#1}{\jobname-\tnv@name.tnv}%
  \VerbatimEnvironment
  \begin{VerbatimOut}{\jobname-\tnv@name.tnv}%
}

\newcommand{\tnvinput}[2][]{%
  \IfFileExists{#2}{}{%
    \PackageError{tnviz}{No tnv file `#2'}{\string\tnvinput\space reads an existing file.}}%
  \begingroup
    \tnv@begin{#1}{#2}%
    \tnv@draw
  \endgroup
}

\endinput
